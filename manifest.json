/* =========================================================
   UPDATE FIREBASE STATUS
========================================================= */

function setFirebaseStatus(
  text,
  className = ""
){

  const element =
    document.getElementById(
      "firebaseStatus"
    );

  if(!element)
    return;

  element.textContent =
    text;

  element.className =
    className;

}


/* =========================================================
   GET FCM TOKEN
========================================================= */

async function getHydroFCMToken(){

  if(!hydroMessaging){

    console.error(
      "Firebase Messaging unavailable"
    );

    setFirebaseStatus(
      "غير متاح"
    );

    return null;

  }


  if(
    !("serviceWorker" in navigator)
  ){

    console.error(
      "Service Worker not supported"
    );

    setFirebaseStatus(
      "غير مدعوم"
    );

    return null;

  }


  try {

    const registration =
      await navigator.serviceWorker.ready;


    const token =
      await getToken(
        hydroMessaging,
        {

          vapidKey:
            HYDRO_VAPID_KEY,

          serviceWorkerRegistration:
            registration

        }
      );


    if(token){

      console.log(
        "Hydro Farm FCM Token:",
        token
      );


      setFirebaseStatus(
        "مفعّل",
        "green"
      );


      const tokenStatus =
        document.getElementById(
          "fcmTokenStatus"
        );


      if(tokenStatus){

        tokenStatus.textContent =
          "مسجل";

        tokenStatus.className =
          "green";

      }


      /*
        نخزن Token محليًا فقط في هذه المرحلة.
        لاحقًا يمكن إرساله إلى Backend / Firestore.
      */

      localStorage.setItem(
        "hydro_fcm_token",
        token
      );


      return token;

    }


    console.warn(
      "No FCM token available"
    );


    setFirebaseStatus(
      "لم يتم إنشاء Token"
    );


    return null;


  } catch(error){

    console.error(
      "FCM token error:",
      error
    );


    setFirebaseStatus(
      "خطأ"
    );


    return null;

  }

}


/* =========================================================
   REQUEST NOTIFICATION PERMISSION
========================================================= */

async function enableHydroNotifications(){

  if(
    !("Notification" in window)
  ){

    console.warn(
      "Browser notifications are not supported"
    );

    setFirebaseStatus(
      "الإشعارات غير مدعومة"
    );

    return null;

  }


  if(
    Notification.permission ===
    "denied"
  ){

    console.warn(
      "Notification permission denied"
    );

    setFirebaseStatus(
      "الإذن مرفوض"
    );

    return null;

  }


  try {

    let permission =
      Notification.permission;


    if(
      permission !== "granted"
    ){

      permission =
        await Notification.requestPermission();

    }


    console.log(
      "Notification permission:",
      permission
    );


    if(
      permission !== "granted"
    ){

      setFirebaseStatus(
        "الإذن غير مفعّل"
      );

      return null;

    }


    return await getHydroFCMToken();


  } catch(error){

    console.error(
      "Notification permission error:",
      error
    );


    setFirebaseStatus(
      "خطأ"
    );


    return null;

  }

}


/* =========================================================
   FOREGROUND FCM MESSAGE
========================================================= */

if(hydroMessaging){

  onMessage(
    hydroMessaging,
    payload => {

      console.log(
        "Hydro Farm FCM message:",
        payload
      );


      const title =
        payload.notification?.title ||
        payload.data?.title ||
        "Hydro Farm";


      const body =
        payload.notification?.body ||
        payload.data?.body ||
        payload.data?.message ||
        "تنبيه جديد من النظام";


      /*
        عرض التنبيه داخل واجهة التطبيق
        إذا كانت الدالة موجودة في app.js.
      */

      if(
        typeof window.addHydroAlert ===
        "function"
      ){

        window.addHydroAlert(
          title,
          body,
          payload.data?.severity ||
          "INFO"
        );

      }


      /*
        Toast إذا كانت الدالة موجودة.
      */

      if(
        typeof window.showToast ===
        "function"
      ){

        window.showToast(
          title
        );

      }


      /*
        Browser notification عندما يكون
        التطبيق مفتوحًا.
      */

      if(
        Notification.permission ===
        "granted"
      ){

        try {

          new Notification(
            title,
            {
              body: body,
              icon: "./icon-192.png"
            }
          );

        } catch(error){

          console.warn(
            "Foreground notification failed:",
            error
          );

        }

      }

    }
  );

}


/* =========================================================
   PUBLIC API
========================================================= */

window.HydroFirebase = {

  app:
    firebaseApp,

  messaging:
    hydroMessaging,

  getFCMToken:
    getHydroFCMToken,

  enableNotifications:
    enableHydroNotifications

};
